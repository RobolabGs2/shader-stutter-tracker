[sub_resource type="GDScript" id="GDScript_c2mjg"]
script/source = "extends ProgressBar

@onready var shader_precompiler: Node3D = %ShaderPrecompiler

	
func _process(delta: float) -> void:
	value = (float(shader_precompiler.ready_triggers) / float(shader_precompiler.total_triggers) * 100)
"

